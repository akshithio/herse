    "@types/react-dom": "^19.0.2",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "ansi-to-html": "^0.7.2",
    "dompurify": "^3.2.3",
