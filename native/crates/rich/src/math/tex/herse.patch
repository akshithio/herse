+    /// Vertical glyph-assembly parts, bottom to top:
+    /// `(gid, start_connector, end_connector, advance, extender)` in font units.
+    pub fn vertical_assembly_parts(&self, glyph_id: u16) -> Vec<(u16, u16, u16, u16, bool)> {
+        let Some(found) = self
+            .math
+            .as_ref()
+            .and_then(|math| math.construction(glyph_id, false))
+        else {
+            return Vec::new();
+        };
+        found
+            .parts
+            .into_iter()
+            .map(|part| {
+                (
+                    part.glyph_id,
+                    part.start_connector,
+                    part.end_connector,
+                    part.full_advance,
+                    part.extender,
+                )
+            })
+            .collect()
+    }
+
+    /// MATH `minConnectorOverlap` in font units (0 without a MATH table).
+    pub fn min_connector_overlap(&self) -> u16 {
+        self.math
+            .as_ref()
+            .and_then(|math| math.min_connector_overlap())
+            .unwrap_or(0)
+    }
