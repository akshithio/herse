+/// herse: `\operatorname{arg\,max}` — math spacing commands in an operator
+/// name become the matching Unicode spaces of the math font.
+fn operator_name_text(raw: &str) -> String {
+    let mut out = String::with_capacity(raw.len());
+    let mut it = raw.chars().peekable();
+    while let Some(c) = it.next() {
+        if c == '\\' {
+            match it.peek() {
+                Some(',') => { it.next(); out.push('\u{2006}'); continue; }
+                Some(':') | Some('>') => { it.next(); out.push('\u{205F}'); continue; }
+                Some(';') => { it.next(); out.push('\u{2005}'); continue; }
+                Some('!') => { it.next(); continue; }
+                Some(' ') => { it.next(); out.push(' '); continue; }
+                _ => {}
+            }
+        }
+        out.push(if c == '~' { ' ' } else { c });
+    }
+    out
