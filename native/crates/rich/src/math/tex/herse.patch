+    /// herse: vertical MATH glyph assembly reaching at least `needed`. Parts are
+    /// stacked bottom to top with each part's baseline at its running offset,
+    /// connector overlaps spread evenly between `minConnectorOverlap` and what
+    /// the connectors allow. Returns a box with height = assembly, depth 0.
+    fn assemble_v(&self, ch: char, gid: u16, needed: &Dim, style: MathStyle) -> Option<MathBox> {
+        let parts = self.font.vertical_assembly_parts(gid);
+        if parts.is_empty() {
+            return None;
+        }
+        let s = self.params.scale(style);
+        let fu = |n: u16| Dim::from_font_units(i64::from(n), self.params.units_per_em) * &s;
+        let min_overlap = fu(self.font.min_connector_overlap());
+        let sequence = |copies: u32| {
+            let mut v = Vec::new();
+            for &(id, start, end, adv, ext) in &parts {
+                let n = if ext { copies } else { 1 };
+                for _ in 0..n {
+                    v.push((id, start, end, adv));
+                }
+            }
+            v
+        };
+        let max_span = |seq: &[(u16, u16, u16, u16)]| {
+            let mut h = Dim::zero();
+            for (i, p) in seq.iter().enumerate() {
+                h = &h + &fu(p.3);
+                if i > 0 {
+                    h = &h - &min_overlap;
+                }
+            }
+            h
+        };
+        let mut copies = 1u32;
+        let mut seq = sequence(copies);
+        while max_span(&seq) < *needed && copies < 256 {
+            copies += 1;
+            seq = sequence(copies);
+        }
+        if seq.is_empty() {
+            return None;
+        }
+        let joints = seq.len().saturating_sub(1);
+        let total: Dim = seq.iter().fold(Dim::zero(), |a, p| &a + &fu(p.3));
+        let uniform = if joints > 0 {
+            ((&total - needed) / Dim::from_i64(joints as i64)).max(&min_overlap)
+        } else {
+            Dim::zero()
+        };
+        let mut kids = Vec::with_capacity(seq.len());
+        let mut offset = Dim::zero();
+        let mut width = Dim::zero();
+        for (i, &(id, start, _, adv)) in seq.iter().enumerate() {
+            if i > 0 {
+                let allowed = fu(seq[i - 1].2.min(start)).max(&min_overlap);
+                offset = &offset - &uniform.min(&allowed);
+            }
+            let g = self.glyph_id(ch, id, style).ok()?;
+            width = width.max(&g.width);
+            kids.push(g.with_shift(offset.clone()));
+            offset = &offset + &fu(adv);
+        }
+        Some(MathBox {
+            width,
+            height: offset,
+            depth: Dim::zero(),
+            italic: Dim::zero(),
+            shift: Dim::zero(),
+            content: BoxContent::Overlap(kids),
+        })
+    }
